{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "py -3 (Join-Path $env:CURSOR_PLUGIN_ROOT 'scripts\\hook.py')",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "py -3 (Join-Path $env:CURSOR_PLUGIN_ROOT 'scripts\\hook.py')",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "py -3 (Join-Path $env:CURSOR_PLUGIN_ROOT 'scripts\\hook.py')",
        "timeout": 15,
        "loop_limit": 1
      }
    ],
    "sessionStart": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $env:CURSOR_PLUGIN_ROOT 'scripts\\ensure-setup.ps1')",
        "timeout": 15
      }
    ]
  }
}
